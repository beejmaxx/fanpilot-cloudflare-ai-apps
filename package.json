{
  "name": "fanpilot-cloudflare-apps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.8.2 <27"
  },
  "scripts": {
    "dev:rally": "npm run dev --workspace=@fanpilot/rally",
    "dev:editor": "npm run dev --workspace=@fanpilot/editor",
    "build": "npm run build --workspaces --if-present",
    "build:rally": "npm run build --workspace=@fanpilot/rally",
    "build:editor": "npm run build --workspace=@fanpilot/editor",
    "test": "npm run test --workspaces --if-present",
    "test:rally": "npm run test --workspace=@fanpilot/rally",
    "test:editor": "npm run test --workspace=@fanpilot/editor",
    "test:e2e:rally": "npm run test:e2e --workspace=@fanpilot/rally",
    "test:e2e:editor": "npm run test:e2e --workspace=@fanpilot/editor",
    "deploy:rally": "npm run deploy --workspace=@fanpilot/rally",
    "deploy:editor": "npm run deploy --workspace=@fanpilot/editor"
  }
}
