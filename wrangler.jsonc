{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rally-planner",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "fanpilot.app/*",
      "zone_name": "fanpilot.app"
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "rally-auth",
      "database_id": "86293ead-a35c-43bf-8de7-4baff3b93a37",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["login@fanpilot.app"],
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RALLY_ROOMS",
        "class_name": "RallyRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RallyRoom"]
    }
  ],
  "workflows": [
    {
      "name": "rally-proposal-workflow",
      "binding": "PROPOSAL_WORKFLOW",
      "class_name": "ProposalWorkflow"
    }
  ]
}
