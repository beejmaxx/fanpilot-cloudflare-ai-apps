{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rally-planner",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [{ "pattern": "rally.fanpilot.app", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RALLY_ROOMS",
        "class_name": "RallyRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RallyRoom"]
    }
  ],
  "workflows": [
    {
      "name": "rally-proposal-workflow",
      "binding": "PROPOSAL_WORKFLOW",
      "class_name": "ProposalWorkflow"
    }
  ]
}
