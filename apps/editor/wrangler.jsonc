{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "draft-collaborative-editor",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAE5eA8JfYx1Syp1k",
    "TURNSTILE_EXPECTED_HOSTNAME": "editor.fanpilot.app"
  },
  "routes": [
    {
      "pattern": "editor.fanpilot.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DOCUMENT_ROOMS",
        "class_name": "DocumentRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DocumentRoom"]
    }
  ],
  "workflows": [
    {
      "name": "draft-ai-edit-workflow",
      "binding": "AI_EDIT_WORKFLOW",
      "class_name": "AiEditWorkflow"
    }
  ],
  "ratelimits": [
    {
      "name": "DOCUMENT_CREATION_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
